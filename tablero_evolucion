  var g=parseInt(hex.substring(2,4),16);
  var b=parseInt(hex.substring(4,6),16);
  return'rgba('+r+','+g+','+b+','+a+')';
}

// ── Cálculo de deltas ───────────────────────────────────────────────────────
// Devuelve {valor, tipo: 'pp'|'pct', cls: 'up'|'down'|'neutral', arrow: '↑'|'↓'|'·'}
function calcDelta(valActual, valPrev, varK){
  if(valActual==null||valPrev==null)return{val:null,tipo:null,cls:'neutral',arrow:'·'};
  var v=getVar(varK);
  var delta, tipo;
  if(v.tipo==='tasa'){delta=valActual-valPrev;tipo='pp';}
  else if(valPrev===0){return{val:null,tipo:null,cls:'neutral',arrow:'·'};}
  else{delta=(valActual/valPrev-1)*100;tipo='pct';}
  if(Math.abs(delta)<0.05)return{val:0,tipo:tipo,cls:'neutral',arrow:'·'};
  // Semáforo: macro subir = malo; granos/hacienda/leche subir = bueno
  var cls;
  if(v.grp==='macro')cls=delta>0?'down':'up';
  else cls=delta>0?'up':'down';
  return{val:delta,tipo:tipo,cls:cls,arrow:delta>0?'↑':'↓'};
}

// ── Cálculo de percentil histórico ──────────────────────────────────────────
// El percentil es contra TODA la historia disponible de esa variable, en la vista activa.
// Devuelve {pct: 0-100, cls: 'up'|'down'|'neutral', arrow: '↑'|'↓'|'·'}
// Convención: percentil alto (>=50) = precio alto vs historia
//   - Para granos/hacienda/leche: percentil alto = bueno (verde)
//   - Para macro (IPC, TC): percentil alto = malo (rojo)
function calcPercentil(valActual, varK){
  if(valActual==null)return{pct:null,cls:'neutral',arrow:'·'};
  var serieFull=transformar(varK);
  var vals=[];
  for(var i=0;i<serieFull.length;i++){if(serieFull[i].v!=null)vals.push(serieFull[i].v);}
  if(vals.length<2)return{pct:null,cls:'neutral',arrow:'·'};
  // Contar cuántos valores son <= valActual
  var menores=0;
  for(var j=0;j<vals.length;j++){if(vals[j]<=valActual)menores++;}
  var pct=Math.round(menores/vals.length*100);
  var v=getVar(varK);
  var cls='neutral', arrow='·';
  if(pct>=70){cls=v.grp==='macro'?'down':'up';arrow='↑';}
  else if(pct<=30){cls=v.grp==='macro'?'up':'down';arrow='↓';}
  return{pct:pct,cls:cls,arrow:arrow};
}


