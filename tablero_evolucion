// ── Render: tarjetas ─────────────────────────────────────────────────────────
function renderCards(){
  var rango=getRango();
  var grupos={macro:[],granos:[],hac:[],leche:[]};
  for(var i=0;i<VARS.length;i++)grupos[VARS[i].grp].push(VARS[i]);
  var elIds={macro:'grpMacro',granos:'grpGranos',hac:'grpHacienda',leche:'grpLeche'};

  for(var g in elIds){
    var html='';
    for(var i=0;i<grupos[g].length;i++){
      var v=grupos[g][i];
      var sNom=SERIE[v.k]||[];
      if(!sNom.length){
        html+='<div class="vc-empty"><div class="vc-empty-name">'+v.n+'</div><div>sin datos cargados</div></div>';
        continue;
      }
      var sTr=transformar(v.k);
      var fil=filtrarRango(sTr,rango.desde,rango.hasta);
      var ultPto=null, primPto=null;
      for(var j=fil.length-1;j>=0;j--){if(fil[j].v!=null){ultPto=fil[j];break;}}
      for(var k=0;k<fil.length;k++){if(fil[k].v!=null){primPto=fil[k];break;}}

      var ultNom=sNom[sNom.length-1];
      var prevNom=sNom.length>=2?sNom[sNom.length-2]:null;

      // Valor a mostrar
      var valMostr=null, unMostr=v.u;
      if(vista==='nom'){valMostr=ultNom?ultNom.v:null;}
      else if(vista==='real'){
        if(v.tipo==='tasa'||v.tipo==='usd_ton'){valMostr=ultNom?ultNom.v:null;}
        else{valMostr=ultNom?ultNom.v:null;unMostr=v.u+' hoy';}
      } else {
        if(v.tipo==='tasa'||v.tipo==='usd_ton'){valMostr=ultNom?ultNom.v:null;}
        else if(v.tipo==='tc'){valMostr=null;unMostr='n/a';}
        else{
          var tcA=ultNom?lookup(SERIE.TC_Oficial_Venta,ultNom.f):null;
          valMostr=(ultNom&&tcA)?ultNom.v/tcA:null;
          unMostr=v.u.replace('$','U$S');
        }
      }

      // Delta m/m
      var prevTr=null;
      if(prevNom){
        var sPrev=transformar(v.k);
        for(var p=sPrev.length-1;p>=0;p--){if(sPrev[p].f===prevNom.f){prevTr=sPrev[p].v;break;}}
      }
      var dMM=calcDelta(ultPto?ultPto.v:null, prevTr, v.k);
      var dPctil=calcPercentil(ultPto?ultPto.v:null, v.k);

      var fmtVal=function(val){if(val==null)return'—';return f(val,v.d);};
      var fmtD=function(obj){
        if(obj.val==null)return'—';
        if(obj.val===0)return'0';
        return obj.tipo==='pp'?fpp(obj.val,1):fp(obj.val,1);
      };

      var pre='', post='';
      if(unMostr.indexOf('U$S')===0){pre='U$S ';post=' '+unMostr.replace('U$S','').trim();}
      else if(unMostr.indexOf('$')===0){pre='$ ';post=' '+unMostr.replace('$','').trim();}
      else{post=' '+unMostr;}
      if(post.trim()==='')post='';

      var actCls=actV[v.k]?'':' off';
      html+='<div class="vc vc-s-'+v.cls+actCls+'" onclick="togVar(\''+v.k+'\')">';
      html+='<div class="vc-top">';
      html+='<div class="vc-head"><span class="vc-name">'+v.n+'</span><span class="vc-fuente">'+v.src+'</span></div>';
      html+='<div class="vc-valrow"><span class="vc-val">'+pre+fmtVal(valMostr)+'</span><span class="vc-unit">'+post+'</span></div>';
      html+='<div class="vc-deltarow">';
      html+='<span class="vc-delta vc-delta-'+dMM.cls+'" title="Variación respecto al mes anterior"><span class="vc-delta-arrow">'+dMM.arrow+'</span>'+fmtD(dMM)+'<span class="vc-delta-lbl">m/m</span></span>';
      html+='<span class="vc-delta vc-delta-'+dPctil.cls+'" title="Percentil del valor actual vs todo el histórico disponible"><span class="vc-delta-arrow">'+dPctil.arrow+'</span>'+(dPctil.pct!=null?'P'+dPctil.pct:'—')+'<span class="vc-delta-lbl">pctil</span></span>';
      html+='<span class="vc-fecha">'+lblMA(ultNom.f)+'</span>';
      html+='</div>';
      html+='</div>';
      html+='<div class="vc-spark-area"><canvas id="spark_'+v.k+'"></canvas></div>';
      html+='</div>';
    }
    document.getElementById(elIds[g]).innerHTML=html;
  }
}

// ── Render: sparklines (con área sombreada) ─────────────────────────────────
function renderSparks(){
  var rango=getRango();
  for(var k in sparks){if(sparks[k]){sparks[k].destroy();}}
  sparks={};
  for(var i=0;i<VARS.length;i++){
    var v=VARS[i];
    var canvas=document.getElementById('spark_'+v.k);
