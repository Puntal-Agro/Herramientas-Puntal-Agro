    });
  }
}

// ── Render: panel "variación último mes" ────────────────────────────────────
function renderVarPanel(){
  var rows=[];
  var maxAbs=0;
  // Calcular delta m/m para cada variable y guardar
  for(var i=0;i<VARS.length;i++){
    var v=VARS[i];
    var sNom=SERIE[v.k];
    if(!sNom||sNom.length<2)continue;
    var ult=sNom[sNom.length-1], prev=sNom[sNom.length-2];
    // En la vista activa
    var sTr=transformar(v.k);
    var ultTr=null, prevTr=null;
    for(var j=sTr.length-1;j>=0;j--){
      if(sTr[j].f===ult.f&&ultTr==null)ultTr=sTr[j].v;
      if(sTr[j].f===prev.f&&prevTr==null)prevTr=sTr[j].v;
      if(ultTr!=null&&prevTr!=null)break;
    }
    if(ultTr==null||prevTr==null)continue;
    var d=calcDelta(ultTr,prevTr,v.k);
    if(d.val==null)continue;
    rows.push({v:v,d:d,fecha:ult.f});
    if(Math.abs(d.val)>maxAbs)maxAbs=Math.abs(d.val);
  }
  // Ordenar por magnitud descendente
  rows.sort(function(a,b){return Math.abs(b.d.val)-Math.abs(a.d.val);});

  var html='';
  for(var r=0;r<rows.length;r++){
    var row=rows[r], pct=maxAbs?Math.min(50,Math.abs(row.d.val)/maxAbs*50):0;
    var fillCls=row.d.val>0?'varbar-fill-pos':(row.d.val<0?'varbar-fill-neg':'');
    var fillStyle='width:'+pct+'%';
    var valCls=row.d.cls==='up'?'varbar-val-pos':(row.d.cls==='down'?'varbar-val-neg':'varbar-val-neutral');
    var valStr=row.d.val===0?'·':(row.d.tipo==='pp'?fpp(row.d.val,2):fp(row.d.val,2));
    html+='<div class="varbar-row">';
    html+='<div class="varbar-name"><span class="varbar-dot" style="background:'+row.v.col+'"></span>'+row.v.n+'</div>';
    html+='<div class="varbar-track">'+(row.d.val!==0?'<div class="varbar-fill '+fillCls+'" style="'+fillStyle+'"></div>':'')+'</div>';
    html+='<div class="varbar-val '+valCls+'">'+valStr+'</div>';
    html+='</div>';
  }
  document.getElementById('varBars').innerHTML=html;
  // Subtítulo
  if(rows.length){
    var ultF=rows[0].fecha;
    document.getElementById('varpanelSub').textContent=lblMA(ultF)+' vs mes anterior · vista '+(vista==='nom'?'Nominal':vista==='real'?'Real':'USD');
  } else {
    document.getElementById('varpanelSub').textContent='sin datos suficientes';
  }
}

// ── Render: gráfico grande ──────────────────────────────────────────────────
function renderBig(){
  var rango=getRango();
  var datasets=[], labelsOrdered=null;

  // Activas con datos
  var activas=[];
  for(var i=0;i<VARS.length;i++){
    var v=VARS[i];
    if(!actV[v.k])continue;
    if(!SERIE[v.k]||!SERIE[v.k].length)continue;
    activas.push(v);
  }

  // Grilla de meses del rango
  if(activas.length){
    var d0=parseISO(rango.desde), d1=parseISO(rango.hasta);
    labelsOrdered=[];
    var ca=d0.a, cm=d0.m;
    while((ca<d1.a)||(ca===d1.a&&cm<=d1.m)){
      labelsOrdered.push(isoFromAM(ca,cm));
      cm++;if(cm===13){cm=1;ca++;}
    }
  }

  for(var z=0;z<activas.length;z++){
    var v=activas[z];
    var sTr=transformar(v.k);
    var fil=filtrarRango(sTr,rango.desde,rango.hasta);
    if(!fil.length)continue;
    var norm=normalizar(fil);
    var map={};
    for(var jj=0;jj<norm.length;jj++)map[norm[jj].f]=norm[jj].v;
    var data=labelsOrdered.map(function(iso){return map[iso]==null?null:map[iso];});
    datasets.push({
      label:v.n,
      data:data,
      borderColor:v.col,
      backgroundColor:hexToRgba(v.col,0.08),
      borderWidth:2,
      pointRadius:0,
      pointHoverRadius:5,
      pointHoverBackgroundColor:v.col,
      pointHoverBorderColor:'#fff',
      pointHoverBorderWidth:2,
      tension:0.3,
      spanGaps:false,
      fill:activas.length<=2 ? true : false  // sólo sombrear si hay pocas series
    });
  }

  if(bigC){bigC.destroy();bigC=null;}
  if(!labelsOrdered||!datasets.length){
    document.getElementById('baseInfo').textContent='(sin variables activas)';
    document.getElementById('legRow').innerHTML='';
    var cv=document.getElementById('bigChart');
    cv.getContext('2d').clearRect(0,0,cv.width,cv.height);
    return;
  }

  document.getElementById('baseInfo').textContent='base 100 = '+lblMA(labelsOrdered[0])+' · '+labelsOrdered.length+' meses · vista '+(vista==='nom'?'Nominal':vista==='real'?'Real':'USD');

  var legHTML='';
  for(var z=0;z<datasets.length;z++){
    // Último valor para mostrar al lado del nombre
    var ult=null;
    for(var ii=datasets[z].data.length-1;ii>=0;ii--){if(datasets[z].data[ii]!=null){ult=datasets[z].data[ii];break;}}
    legHTML+='<span class="leg"><span class="leg-line" style="background:'+datasets[z].borderColor+'"></span>'+datasets[z].label+(ult!=null?' <span style="color:#7A8899;font-family:DM Mono;font-size:10px;margin-left:3px">'+f(ult,1)+'</span>':'')+'</span>';
  }
  document.getElementById('legRow').innerHTML=legHTML;

  var dispLabels=labelsOrdered.map(lblMA);

  // Plugin: anotación de último valor al final de cada línea
  var endLabelPlugin={
    id:'endLabel',
    afterDatasetsDraw:function(chart){
      var ctx=chart.ctx;
      ctx.save();
      ctx.font='600 10px DM Mono';
      ctx.textAlign='left';
      ctx.textBaseline='middle';
      chart.data.datasets.forEach(function(ds,i){
        var meta=chart.getDatasetMeta(i);
        // último punto no-null
        var lastIdx=-1;
        for(var ii=ds.data.length-1;ii>=0;ii--){if(ds.data[ii]!=null){lastIdx=ii;break;}}
        if(lastIdx<0)return;
        var pt=meta.data[lastIdx];
        if(!pt)return;
        var v=ds.data[lastIdx];
        var txt=f(v,0);
        ctx.fillStyle=ds.borderColor;
        // Fondo blanco para legibilidad
        var w=ctx.measureText(txt).width+8;
        ctx.fillStyle='rgba(255,255,255,0.85)';
        ctx.fillRect(pt.x+4,pt.y-7,w,14);
        ctx.fillStyle=ds.borderColor;
        ctx.fillText(txt,pt.x+8,pt.y);
      });
      ctx.restore();
    }
  };

  bigC=new Chart(document.getElementById('bigChart'),{
    type:'line',
    data:{labels:dispLabels,datasets:datasets},
    plugins:[endLabelPlugin],
    options:{
      responsive:true,maintainAspectRatio:false,
      layout:{padding:{right:50}},  // espacio para las etiquetas finales
      plugins:{
        legend:{display:false},
        tooltip:{
          mode:'index',intersect:false,
          callbacks:{
            label:function(ctx){
              if(ctx.parsed.y==null)return'';
              var vMatch=null;
              for(var i=0;i<VARS.length;i++)if(VARS[i].n===ctx.dataset.label){vMatch=VARS[i];break;}
              if(!vMatch)return ' '+ctx.dataset.label+': '+f(ctx.parsed.y,1);
              var iso=labelsOrdered[ctx.dataIndex];
              var sTr2=transformar(vMatch.k);
              var valReal=null;
              for(var p=0;p<sTr2.length;p++)if(sTr2[p].f===iso){valReal=sTr2[p].v;break;}
              var pre=vMatch.u.indexOf('$')===0?'$ ':(vMatch.u.indexOf('U$S')===0?'U$S ':'');
              var post=pre?'':' '+vMatch.u;
              return ' '+vMatch.n+': idx '+f(ctx.parsed.y,1)+(valReal!=null?'  ·  '+pre+f(valReal,vMatch.d)+post:'');
            }
          }
        }
      },
      scales:{
        x:{ticks:{font:{size:9,family:'DM Mono'},maxRotation:45,autoSkip:true,maxTicksLimit:16},grid:{color:'rgba(0,0,0,0.03)'}},
        y:{ticks:{font:{size:9,family:'DM Mono'},callback:function(v){return f(v,0);}},grid:{color:'rgba(0,0,0,0.05)'},
           title:{display:true,text:'índice (base 100)',font:{size:10,family:'DM Sans'},color:'#7A8899'}}
      },
      interaction:{mode:'nearest',axis:'x',intersect:false}
    }
  });
}

// ── Eventos ──────────────────────────────────────────────────────────────────
function setVista(v,btn){
  vista=v;
  var btns=document.querySelectorAll('.inst-btn');
  for(var i=0;i<btns.length;i++)btns[i].classList.remove('active');
  btn.classList.add('active');
  var d={nom:'Valores en su unidad natural',real:'$ deflactados a pesos del último mes',usd:'$ convertidos a USD por TC oficial mensual'};
  document.getElementById('vistaDesc').textContent=d[v];
  renderAll();
}

function setPer(p,btn){
  periodo=p;
  var btns=document.querySelectorAll('.per-btn');
  for(var i=0;i<btns.length;i++)btns[i].classList.remove('on');
  if(btn)btn.classList.add('on');
  document.getElementById('perCustom').classList.remove('show');
  renderAll();
}

function toggleCustom(btn){
  var el=document.getElementById('perCustom');
  el.classList.toggle('show');
  if(el.classList.contains('show')){
    var btns=document.querySelectorAll('.per-btn');
    for(var i=0;i<btns.length;i++)btns[i].classList.remove('on');
    btn.classList.add('on');
  }
}

function applyCustom(){
  var fv=document.getElementById('cFrom').value;
  var tv=document.getElementById('cTo').value;
  if(!fv||!tv)return;
  var fp=fv.split('-'), tp=tv.split('-');
  customFrom={a:parseInt(fp[0],10),m:parseInt(fp[1],10)};
  customTo={a:parseInt(tp[0],10),m:parseInt(tp[1],10)};
  periodo='custom';
  renderAll();
}

function togBlock(g){
  blockCollapsed[g]=!blockCollapsed[g];
  applyBlockState(g);
}

function applyBlockState(g){
  var gridId={macro:'grpMacro',granos:'grpGranos',hac:'grpHacienda',leche:'grpLeche'}[g];
  var blockId='block-'+g;
  var tgId='tg-'+g;
  var grid=document.getElementById(gridId);
  var block=document.getElementById(blockId);
  var tg=document.getElementById(tgId);
  if(blockCollapsed[g]){
    grid.classList.add('collapsed');
    block.classList.add('collapsed');
    tg.textContent='▸';
  } else {
    grid.classList.remove('collapsed');
    block.classList.remove('collapsed');
    tg.textContent='▾';
  }
}

function togVar(k){actV[k]=!actV[k];renderPills();renderCards();renderSparks();renderVarPanel();renderBig();}

function renderAll(){
  renderPills();renderBlockCounts();renderCards();renderSparks();renderVarPanel();renderBig();
  applyBlockState('macro');applyBlockState('granos');applyBlockState('hac');applyBlockState('leche');
  document.getElementById('fts').textContent=new Date().toLocaleString('es-AR');
}

function initCustom(){
  var todasFechas={};
  for(var i=0;i<VARS.length;i++){var s=SERIE[VARS[i].k];for(var j=0;j<s.length;j++)todasFechas[s[j].f]=1;}
  var arr=Object.keys(todasFechas).sort();
  if(!arr.length)return;
  var html='';
  for(var k=0;k<arr.length;k++){
    var p=parseISO(arr[k]);
    var lbl=ML[p.m]+'-'+String(p.a).slice(2);
    var val=p.a+'-'+(p.m<10?'0':'')+p.m;
    html+='<option value="'+val+'">'+lbl+'</option>';
  }
  document.getElementById('cFrom').innerHTML=html;
  document.getElementById('cTo').innerHTML=html;
  document.getElementById('cFrom').value=arr[Math.max(0,arr.length-13)].substring(0,7);
  document.getElementById('cTo').value=arr[arr.length-1].substring(0,7);
}

document.getElementById('updBadge').textContent='Datos al '+FECHA_DATOS;
initCustom();
renderAll();
</script>
